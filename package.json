{
  "name": "@shoroi/form",
  "description": "表单",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style/*": {
      "default": "./style/*.scss"
    }
  },
  "files": [
    "dist",
    "style"
  ],
  "scripts": {
    "build:ant": "cd examples/element-plus && npm run build",
    "build:element": "cd examples/vue && npm run build",
    "build:form": "tsc --sourceMap false --incremental false -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --w src/**/*{.ts,.tsx}",
    "format:examples": "prettier --w examples/**/*{.ts,.vue}",
    "prebuild": "npm run build:ant && npm run build:element",
    "test": "vitest watch",
    "test-vue": "vitest dev -c vitest.vue.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@volar/vue-typescript": "^1.6.5",
    "@vue/test-utils": "^2.4.6",
    "element-plus": "^2.9.0",
    "execa": "^8.0.1",
    "jsdom": "^23.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-packagejson": "^2.5.6",
    "sass": "^1.82.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitepress": "^1.5.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "async-validator": "^4.2.5",
    "vue": "^3.4.33"
  }
}
